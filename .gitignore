# Backups automáticos de KiCad
*.bak
*-backups/

# Archivos de bloqueo (proyecto abierto en la GUI)
~*.lck
*.kicad_prl

# Snapshots propios: git ya cumple esta función
.versions/
.history/
recovery_*/

# Salidas regenerables
report.txt
*-drc-prelayout.rpt

# Fabricación (no versionar hasta que haya una revisión congelada)
gerbers/
*.gbr
*.drl
*.zip

# Intercambio con Freerouting (se regenera con tools/autorutear.py)
*.dsn
*.rules
*.ses
*-autorruteada.kicad_pcb

# El PDF del resumen se regenera con kicad-cli desde el .kicad_sch versionado
RESUMEN_ELECTRICO.pdf

# Informes de DRC/ERC: se regeneran, y versionarlos confunde
DRC.rpt
*-drc*.rpt
*-erc.rpt

# Ajustes locales del agente
.claude/
